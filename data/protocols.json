          "conditions": [{"answer": {"breathing": "no"}}, {"answer": {"conscious": "no"}}],
          "priority": "Echo / Priority 1 Medical — Critical",
          "add_plan": ["Supervisor notify: critical medical"],
          "add_units": [{"id": "E3", "reason": "Engine for first response / CPR support"}]
        }
      ]
    }
  },
